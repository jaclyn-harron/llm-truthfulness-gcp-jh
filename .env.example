# Copy to .env and fill in. .env is gitignored and must never be committed.
# There are NO API keys: authentication is Application Default Credentials.
# Locally, run once:   gcloud auth application-default login
# On Cloud Run, the runtime service account is used automatically.

# Required: your GCP project and Vertex region.
GOOGLE_CLOUD_PROJECT=my-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Required only to LAUNCH a fine-tuning job (staging bucket for JSONL data).
# Bucket name only, no gs:// prefix. Must be in the same project.
TRUTHFULNESS_GCS_BUCKET=my-project-truthfulness-tuning

# Set after tuning completes to reuse the tuned model (full endpoint resource
# name printed by the tuning run):
# TRUTHFULNESS_FINE_TUNED_MODEL=projects/123456789/locations/us-central1/endpoints/987654321

# --- Optional overrides (defaults shown in truthfulness/config.py) ---
# TRUTHFULNESS_ZERO_SHOT_MODEL=gemini-2.5-flash
# TRUTHFULNESS_EXPLAINER_MODEL=gemini-2.5-flash
# TRUTHFULNESS_FT_BASE_MODEL=gemini-2.5-flash   # tunable: 2.5-flash | 2.5-flash-lite | 2.5-pro
# TRUTHFULNESS_FT_EPOCHS=0                      # 0 = let Vertex choose
# TRUTHFULNESS_FT_ADAPTER_SIZE=0                # 0 = default; else 1|2|4|8|16|32
# TRUTHFULNESS_THINKING_BUDGET=0                # 0 disables Gemini 2.5 thinking on flash models
# TRUTHFULNESS_MAX_CONCURRENCY=8
# TRUTHFULNESS_SEED=123
